  "item": [
    {
      "name": "01. Authentication & OTP (Redis)",
      "item": [
        {
          "name": "1.1 Gửi OTP (Email Phenikaa .edu.vn)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@phenikaa-uni.edu.vn\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/send-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "send-otp"]
            },
            "description": "Gửi mã OTP 6 số đến email trường sinh viên. Mã được lưu vào Redis với TTL 5 phút, cooldown chống spam 60s."
          }
        },
        {
          "name": "1.2 Gửi OTP (Email trường khác .edu.vn)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nguyenvana@daihocquangbinh.edu.vn\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/send-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "send-otp"]
            },
            "description": "Gửi OTP cho trường đại học khác có đuôi .edu.vn hợp lệ."
          }
        },
        {
          "name": "1.3 Test Chặn Email không phải .edu.vn (Lỗi 40001)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nguoidung@gmail.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/send-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "send-otp"]
            },
            "description": "Kiểm tra tính năng bảo mật: Chặn đứng mọi email không có đuôi .edu.vn và trả về mã lỗi 40001."
          }
        },
        {
          "name": "1.4 Xác thực mã OTP trong Redis",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@phenikaa-uni.edu.vn\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "verify-otp"]
            },
            "description": "Xác thực mã OTP từ Redis. Khi đúng mã, Redis sẽ lập tức hủy key để chống tấn công Replay Attack."
          }
        },
        {
          "name": "1.5 Đăng ký tài khoản Sinh viên (+20 Karma)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Trần Minh Đức\",\n  \"email\": \"duc.tm2101@phenikaa-uni.edu.vn\",\n  \"password\": \"Aa123456\",\n  \"universityId\": 5,\n  \"campusId\": 8,\n  \"dormitory\": \"Phòng 402 - KTX Phenikaa\",\n  \"studentCode\": \"21012345\",\n  \"phone\": \"0912345678\",\n  \"otp\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Tạo tài khoản sinh viên mới. Tặng ngay +20 điểm Campus Karma ban đầu."
          }
        },
        {
          "name": "1.6 Đăng nhập Sinh viên (Tự động lưu Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set('studentToken', jsonData.data.accessToken);",
                  "    console.log('✅ Đã tự động lưu studentToken vào Collection Variables!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@phenikaa-uni.edu.vn\",\n  \"password\": \"Aa123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Đăng nhập tài khoản sinh viên Phenikaa (Mật khẩu: Aa123). Script test sẽ tự động lưu `studentToken`."
          }
        },
        {
          "name": "1.7 Đăng nhập Admin (Tự động lưu adminToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set('adminToken', jsonData.data.accessToken);",
                  "    console.log('✅ Đã tự động lưu adminToken vào Collection Variables!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@gmail.com\",\n  \"password\": \"Aa123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Đăng nhập tài khoản Quản trị viên (admin@gmail.com / Aa123). Script test sẽ tự động lưu `adminToken`."
          }
        },
        {
          "name": "1.8 Lấy thông tin tài khoản hiện tại (/auth/me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "Lấy thông tin người dùng từ JWT Access Token."
          }
        },
        {
          "name": "1.9 Đăng xuất (/auth/logout)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "02. Public APIs (Dữ liệu công khai & Tìm kiếm)",
      "item": [
        {
          "name": "2.1 Lấy danh sách Trường Đại học (Kèm Phenikaa & Khác)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/public/universities",
              "host": ["{{baseUrl}}"],
              "path": ["public", "universities"]
            },
            "description": "Trả về hơn 27 trường đại học. Trường Phenikaa nằm ở vị trí ID 5, và 'Các trường đại học khác' được sắp xếp ở cuối danh sách (ID 99)."
          }
        },
        {
          "name": "2.2 Lấy danh sách cơ sở của ĐH Phenikaa (ID 5)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/public/universities/5/campuses",
              "host": ["{{baseUrl}}"],
              "path": ["public", "universities", "5", "campuses"]
            },
            "description": "Trả về các cơ sở của Đại học Phenikaa (Cơ sở Yên Nghĩa, Ký túc xá Phenikaa)."
          }
        },
        {
          "name": "2.3 Lấy danh mục sản phẩm (Categories)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/public/categories",
              "host": ["{{baseUrl}}"],
              "path": ["public", "categories"]
            },
            "description": "Danh mục: Giáo trình & Sách vở, Thiết bị công nghệ, Đồ dùng phòng trọ, Thể thao, Thời trang."
          }
        },
        {
          "name": "2.4 Lấy danh sách bài đăng công khai mới nhất",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/public/listings?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["public", "listings"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "2.5 Tìm kiếm tin đăng nâng cao (Bộ lọc đa chiều)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/public/listings/search?keyword=giáo trình&categoryId=1&transactionType=SELL&minPrice=0&maxPrice=100000&page=0&size=15",
              "host": ["{{baseUrl}}"],
              "path": ["public", "listings", "search"],
              "query": [
                { "key": "keyword", "value": "giáo trình" },
                { "key": "categoryId", "value": "1" },
                { "key": "transactionType", "value": "SELL" },
                { "key": "minPrice", "value": "0" },
                { "key": "maxPrice", "value": "100000" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "15" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "03. Student Listings (Đăng bán / Tặng / Quản lý tin)",
      "item": [
        {
          "name": "3.1 Đăng bài bán đồ cũ (SELL)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set('listingId', jsonData.data.id);",
                  "    console.log('✅ Đã lưu listingId mới: ' + jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Giáo trình Giải tích 1 & Đại số tuyến tính ĐH Phenikaa\",\n  \"description\": \"Sách còn mới 95%, có ghi chú bài tập giải chi tiết các kỳ thi giữa kỳ và cuối kỳ trước. Nhượng lại cho bạn nào cần.\",\n  \"categoryId\": 1,\n  \"price\": 45000,\n  \"transactionType\": \"SELL\",\n  \"conditionStatus\": \"LIKE_NEW_99\",\n  \"imageUrls\": [\n    \"https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?w=600\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/student/listings",
              "host": ["{{baseUrl}}"],
              "path": ["student", "listings"]
            },
            "description": "Đăng tin bán thanh lý sách vở/đồ dùng."
          }
        },
        {
          "name": "3.2 Đăng bài Tặng đồ miễn phí (GIVEAWAY - Giá 0đ)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Tặng móc treo quần áo và rổ đựng đồ phòng trọ\",\n  \"description\": \"Mình dọn phòng về quê nên tặng lại cho tân sinh viên khó khăn hoặc bạn nào cần ở KTX Yên Nghĩa.\",\n  \"categoryId\": 3,\n  \"price\": 0,\n  \"transactionType\": \"GIVEAWAY\",\n  \"conditionStatus\": \"GOOD_90\",\n  \"imageUrls\": [\n    \"https://images.unsplash.com/photo-1586023492125-27b2c045efd7?w=600\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/student/listings",
              "host": ["{{baseUrl}}"],
              "path": ["student", "listings"]
            },
            "description": "Đăng tin tặng đồ (Bắt buộc giá = 0đ)."
          }
        },
        {
          "name": "3.3 Xem danh sách tin đăng của tôi",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/student/my-listings?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["student", "my-listings"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "3.4 Cập nhật thông tin bài đăng",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"[ĐÃ GIẢM GIÁ] Giáo trình Giải tích 1 ĐH Phenikaa\",\n  \"description\": \"Giảm giá cho bạn nào qua lấy trực tiếp tại KTX Bách Khoa hoặc KTX Phenikaa.\",\n  \"categoryId\": 1,\n  \"price\": 35000,\n  \"conditionStatus\": \"LIKE_NEW_99\",\n  \"imageUrls\": [\n    \"https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?w=600\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/student/listings/{{listingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["student", "listings", "{{listingId}}"]
            }
          }
        },
        {
          "name": "3.5 Cập nhật trạng thái tin (Đã bán SOLD / Ẩn tin HIDE)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SOLD\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/student/listings/{{listingId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["student", "listings", "{{listingId}}", "status"]
            }
          }
        },
        {
          "name": "3.6 Xóa tin đăng",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/student/listings/{{listingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["student", "listings", "{{listingId}}"]
            }
          }
        }
      ]
    },
