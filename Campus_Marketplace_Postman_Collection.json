{
  "info": {
    "_postman_id": "c8e192a0-8a4b-4f9e-9d8a-campus-marketplace-2026",
    "name": "Campus Marketplace - REST API Collection",
    "description": "Bộ sưu tập Postman hoàn chỉnh dành cho nền tảng Chợ đồ cũ sinh viên (Campus Marketplace). Bao gồm đầy đủ các luồng: Xác thực OTP Redis, Định danh sinh viên .edu.vn, Đăng bán/tặng đồ, Chat, Thuê đồ, Đổi đồ, Báo cáo vi phạm và Cổng Quản trị Admin.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "studentToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "listingId",
      "value": "1",
      "type": "string"
    },
    {
